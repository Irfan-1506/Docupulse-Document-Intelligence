# ==============================================================================
# DocuPulse Enterprise AP v4.2 - Environment Configuration Template
# Copy this file to .env and configure secret keys and service addresses.
# ==============================================================================

# ------------------------------------------------------------------------------
# Application Environment & Logging
# ------------------------------------------------------------------------------
APP_ENV=production                  # development | staging | production
LOG_LEVEL=INFO                      # DEBUG | INFO | WARNING | ERROR
API_PORT=8000
HOST=0.0.0.0

# ------------------------------------------------------------------------------
# Relational Database (PostgreSQL 16 with pgvector)
# ------------------------------------------------------------------------------
POSTGRES_USER=docupulse
POSTGRES_PASSWORD=docupulse_secret_change_me
POSTGRES_DB=docupulse_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://docupulse:docupulse_secret_change_me@postgres:5432/docupulse_db

# ------------------------------------------------------------------------------
# Redis Task Queue & Worker Telemetry
# ------------------------------------------------------------------------------
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
USE_REDIS_QUEUE=true
QUEUE_CONCURRENCY=4

# ------------------------------------------------------------------------------
# AI LLM Provider Configuration
# ------------------------------------------------------------------------------
# Primary Google Gemini API Key (Structured Outputs)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Optional OpenAI / Local Ollama Configuration
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# ------------------------------------------------------------------------------
# OCR & Vision Pipeline Settings
# ------------------------------------------------------------------------------
DEFAULT_OCR_ENGINE=rapidocr          # rapidocr | tesseract
OCR_DPI=300
ENABLE_IMAGE_ENHANCEMENT=true       # 4-stage OpenCV contrast, deskew, and denoise

# ------------------------------------------------------------------------------
# File Storage Paths
# ------------------------------------------------------------------------------
UPLOAD_DIR=/app/data/uploads
TEMP_DIR=/app/data/temp
MAX_UPLOAD_SIZE_MB=100
